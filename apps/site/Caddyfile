# powerbimetricsbook.io's files. Dokploy's Traefik ends TLS in front of this
# and passes plain HTTP to port 8080, so Caddy manages no certificates.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	@www host www.powerbimetricsbook.io
	redir @www https://powerbimetricsbook.io{uri} permanent

	# Astro names these files by their content, so a new build gets new names.
	@hashed path /_astro/* /docs/_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# /docs/set-up redirects to /docs/set-up/, as the site's links are written.
	file_server

	# A missing page gets the nearest 404 page: the docs' own under /docs,
	# the landing page's everywhere else. The status stays 404.
	handle_errors 404 {
		@docs path /docs /docs/*
		handle @docs {
			rewrite * /docs/404.html
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}
}
