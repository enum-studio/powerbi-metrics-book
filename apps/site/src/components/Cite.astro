---
// A numbered citation that links to its entry in the Sources list. `at` tells
// two citations of one source apart, so each entry can link back to both.
interface Props {
  n: number;
  at: string;
}

const { n, at } = Astro.props;
---

<sup class="cite"><a id={`cite-${String(n)}${at}`} href={`#source-${String(n)}`}>{n}</a></sup>

<style>
  .cite {
    font-size: 0.7em;
    line-height: 0;
  }
  .cite a {
    margin-left: 1px;
    color: var(--accent);
    text-decoration: none;
  }
  .cite a:hover {
    text-decoration: underline;
  }
  .cite a:target {
    scroll-margin-top: var(--space-8);
  }
</style>
