---
// The landing page's header: the mark and the name, then Demo, Docs, Changelog
// and GitHub. The docs header (apps/docs) starts with the same mark and name,
// which lead back here, and ends with the same GitHub link.
import mark from "@enum-studio/tokens/mark.svg?raw";
import { LINKS } from "../links";
import GitHubMark from "./GitHubMark.astro";
---

<header class="bar">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true" set:html={mark} />
      <span class="name" translate="no">Power BI Metrics Book</span>
    </a>
    <nav aria-label="Site">
      <a href={LINKS.demo}>Demo</a>
      <a href={LINKS.docs}>Docs</a>
      <a class="wide" href={LINKS.changelog}>Changelog</a>
      <a class="github" href={LINKS.github} aria-label="Power BI Metrics Book on GitHub">
        <GitHubMark />
      </a>
      <button class="theme" type="button" data-theme-switch aria-label="Switch to dark mode">
        <svg class="moon" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" />
        </svg>
        <svg class="sun" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="3.5" />
          <path
            d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4"
          />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Flips the theme the page shows now, and keeps the choice under
  // Starlight's key, so the docs open in it too. Until a reader picks one,
  // the system setting decides.
  const root = document.documentElement;
  const system = window.matchMedia("(prefers-color-scheme: dark)");
  const dark = () =>
    root.dataset.theme === "dark" ||
    (root.dataset.theme !== "light" && system.matches);

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-switch]",
  )) {
    const label = () => {
      button.setAttribute(
        "aria-label",
        dark() ? "Switch to light mode" : "Switch to dark mode",
      );
    };
    label();
    system.addEventListener("change", label);
    button.addEventListener("click", () => {
      const theme = dark() ? "light" : "dark";
      root.dataset.theme = theme;
      try {
        localStorage.setItem("starlight-theme", theme);
      } catch {
        // Storage can be blocked; the choice then lasts for this page only.
      }
      label();
    });
  }
</script>

<style>
  .bar {
    border-bottom: 1px solid var(--line);
  }
  .wrap {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 56px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    margin-right: auto;
    color: var(--ink);
    text-decoration: none;
  }
  .mark {
    display: flex;
    flex: none;
    width: 1.25rem;
  }
  .name {
    overflow: hidden;
    font-size: var(--type-name);
    font-weight: 600;
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-size: var(--type-ui);
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
  }
  .github {
    display: flex;
    color: var(--ink);
  }
  .github :global(svg) {
    width: 20px;
    height: 20px;
  }
  .theme {
    display: flex;
    padding: var(--space-1);
    margin: calc(-1 * var(--space-1));
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--ink-2);
    cursor: pointer;
  }
  .theme:hover {
    color: var(--ink);
  }
  .theme svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The icon shows the mode a click switches to. */
  .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .sun {
    display: block;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      display: block;
    }
    :global(:root:not([data-theme="light"])) .moon {
      display: none;
    }
  }
  @media (max-width: 559px) {
    .wrap {
      gap: var(--space-4);
    }
    .name {
      font-size: 1.05rem;
    }
    nav {
      gap: var(--space-4);
    }
    .wide {
      display: none;
    }
  }
</style>
