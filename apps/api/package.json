{
  "name": "@powerbi-metrics-book/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli-entry.ts api",
    "start": "node dist/cli-entry.js api",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:policies": "../../access/run_policy_tests.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "openapi": "tsx src/routes/openapi.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@better-auth/sso": "1.7.12",
    "@cerbos/core": "0.33.1",
    "@cerbos/http": "0.30.1",
    "@hono/node-server": "2.1.5",
    "age-encryption": "0.3.1",
    "better-auth": "1.7.12",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "hono-openapi": "1.5.0",
    "pg": "8.23.1",
    "undici": "8.12.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@powerbi-metrics-book/powerbi-mock": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
