---
// The mark inline, because it draws in currentColor and an <img> cannot
// inherit the page's ink.
import mark from "@enum-studio/tokens/mark.svg?raw";
import { PUBLIC_SITE } from "../site";

// On the public site the title goes home to the landing page, as its header
// does; in a deployment it goes to the docs' front page.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const href = PUBLIC_SITE ? "/" : siteTitleHref;
---

<a href={href} class="site-title">
  <span class="mark" aria-hidden="true" set:html={mark} />
  <span class="name" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }
  .mark {
    display: flex;
    flex: none;
    width: 1.25rem;
  }
  .name {
    overflow: hidden;
    font-size: var(--type-name);
    font-weight: 600;
    white-space: nowrap;
  }
</style>
