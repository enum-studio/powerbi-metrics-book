---
// Starlight's banner, plus one line on every page of the public site until
// 0.1 ships. A deployment runs a release, so its own copy never shows it.
import Default from "@astrojs/starlight/components/Banner.astro";
import { PUBLIC_SITE } from "../site";
---

{
  PUBLIC_SITE && (
    <div class="sl-banner" data-pagefind-ignore>
      Not released yet: nothing on these pages installs until 0.1, the first release.{" "}
      <a href="https://github.com/enum-studio/powerbi-metrics-book/blob/main/CONTRIBUTING.md">
        Run it on the sample tenant
      </a>{" "}
      today.
    </div>
  )
}
<Default />

<style>
  .sl-banner {
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--accent);
    color: var(--on-accent);
    font-size: var(--type-ui);
    text-align: center;
    text-wrap: balance;
  }
  .sl-banner a {
    color: var(--on-accent);
  }
</style>
