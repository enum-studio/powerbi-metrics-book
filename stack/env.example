# The bootstrap values: only what a container needs before it can read its own
# database. Everything else is set in the product and kept in Postgres.
#
# pbmb init writes the real file as .env beside compose.yml, mode 0600, with
# random passwords and a random AUTH_SECRET. Never commit a .env. Each
# password goes into the URL compose.yml builds for its role, so use letters
# and digits only.

# The https address people open, such as https://metrics.example.com. The api
# builds sign-in redirects and links from it.
PUBLIC_BASE_URL=

# Postgres's own superuser, used by the image's first start and nothing else.
POSTGRES_PASSWORD=

# migrator owns every table. Only the api gets it, to apply migrations at start.
MIGRATOR_PASSWORD=

# api_rw, the api's own role (its DATABASE_URL).
API_RW_PASSWORD=

# worker_rw, the worker's own role (its DATABASE_URL).
WORKER_RW_PASSWORD=

# audit_writer, which may only insert into audit_event and query_log. The api
# and the worker both get it (AUDIT_DATABASE_URL).
AUDIT_WRITER_PASSWORD=

# Better Auth's signing secret for sessions and tokens. The api only. At least
# 32 random bytes; changing it signs everyone out.
AUTH_SECRET=

# The host port the api is published on, on 127.0.0.1, for the reverse proxy.
# Empty means 3000.
PBMB_PORT=

# debug, info, warn or error. Empty means info.
LOG_LEVEL=

# The reverse proxy's address, or a CIDR range holding it (not /0). Sign-in
# rate limits count by client address, and only a connection from here may
# name the client in X-Forwarded-For. Caddy from deploy/vm has a fixed
# address on the edge network, 172.30.80.10: set that address.
# Traefik under Dokploy connects over dokploy-network instead: set
# dokploy-traefik's own address on it, never the network's range, which
# every other app on the server joins (the Dokploy guide's step 4 finds it).
# A proxy elsewhere: the address its connections reach the api from. Empty,
# every attempt counts against the address that connected, so behind a
# proxy everyone shares one limit, and no service account may be held to
# source CIDRs, since every request would seem to come from the proxy.
TRUSTED_PROXY=

# Not read from this file: compose.yml does not pass it on. x-real-ip makes
# the api take the client's address from X-Real-IP on every request, and
# ignore X-Forwarded-For. It is safe only on a platform whose edge sets that
# header on every request and is the api's only public route, such as
# Railway, set in the platform's own variables; anywhere else a client could
# send the header and pick its own address. Never with TRUSTED_PROXY, and no
# service account may be held to source CIDRs under it.
# CLIENT_ADDRESS_HEADER=x-real-ip

# The edge network's range. Empty means 172.30.80.0/24; change it only when
# that range is taken on this host, and change TRUSTED_PROXY with it.
PBMB_EDGE_SUBNET=

# Optional, so commented out: each container's age identity
# (AGE-SECRET-KEY-1...), when it should come from here rather than the
# identity volume. Each container gets only its own. Unset, the container
# makes one in its volume on first start. Set to empty, it would be passed on
# empty, so remove the line instead.
# API_AGE_IDENTITY=
# WORKER_AGE_IDENTITY=
