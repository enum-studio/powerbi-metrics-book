# Settings for pbmb-backup.sh and pbmb-backup-failed.service, as
# /etc/pbmb-backup.env, mode 0600: PBMB_BACKUP_ALERT_URL works as a password.
# The storage credentials are in /etc/pbmb-backup/dumps.conf and
# identities.conf, one rclone config each.

# The compose project: the deployment directory's name (pbmb for /srv/pbmb),
# or the app name Dokploy shows for the compose application.
PBMB_PROJECT=pbmb

# An address that takes a POST when a backup fails, such as a healthchecks.io
# check's /fail address or an ntfy topic. Empty: a failure shows only in
# journalctl and systemctl --failed.
PBMB_BACKUP_ALERT_URL=
